# انسخ الملف ده باسم .env وحط قيمك (ملف .env مش بيترفع على GitHub).
# من Supabase: Settings ← API

# رابط المشروع (Project URL)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# الـ Secret key (service_role) — مش الـ Publishable. ده سر، مينفعش يتحط في أي كود بيظهر للمتصفح.
SUPABASE_SERVICE_ROLE_KEY=

# اختياري ------------------------------------------------------------
# لإجبار وضع معين: local = ملفات data/ حتى لو المفاتيح فوق موجودة | supabase = قاعدة البيانات
# من غير ما تحدده: بيشتغل Supabase لو المفاتيح موجودة، وإلا لوكال (وعلى Vercel دايمًا Supabase)
# STORAGE_MODE=supabase

# اسم الـ bucket الخاص بصور الدردشة والبروفايل والإعلانات والاختبارات (الافتراضي app-files)
# SUPABASE_FILES_BUCKET=app-files
